{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "repo-launcher",
  "version": "0.2.0",
  "identifier": "com.stevenp.repo-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Repo Launcher",
        "width": 600,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "Repo Launcher — Settings",
        "width": 820,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
